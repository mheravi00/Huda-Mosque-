# Public Supabase project configuration (safe for browser initialization).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose through NEXT_PUBLIC_* or client-side code.
SUPABASE_SECRET_KEY=

# Optional provider configuration. Without these, deterministic mock adapters are used.
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional deployment rate-limit provider. Sensitive routes should be rate-limited in production.
RATE_LIMIT_PROVIDER=
